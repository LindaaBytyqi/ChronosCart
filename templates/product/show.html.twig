{% extends 'base.html.twig' %}

{% block title %}View Product{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">

                <div class="card-header bg-dark text-white">
                    <h1 class="h5 mb-0">Product Details</h1>
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>ID:</strong> {{ product.id }}
                    </li>

                    <li class="list-group-item">
                        <strong>Image:</strong>
                        {% if product.imageName %}
                            <div class="mt-2">
                                <img
                                    src="{{ asset('uploads/products/' ~ product.imageName) }}"
                                    alt="{{ product.name }}"
                                    class="img-fluid rounded"
                                    style="max-width: 200px; max-height: 200px; object-fit: cover;"
                                >
                            </div>
                        {% else %}
                            <span class="text-muted">No image available</span>
                        {% endif %}
                    </li>

                    <li class="list-group-item">
                        <strong>SKU:</strong> {{ product.sku }}
                    </li>

                    <li class="list-group-item">
                        <strong>Name:</strong> {{ product.name }}
                    </li>

                    <li class="list-group-item">
                        <strong>Price:</strong> €{{ product.basePrice }}
                    </li>

                    <li class="list-group-item">
                        <strong>Initial Stock:</strong> {{ product.initialStock }}
                    </li>

                    <li class="list-group-item">
                        <strong>Status:</strong> {{ product.status }}
                    </li>
                </ul>

                <div class="card-body d-flex gap-2">
                    <a href="{{ path('app_product_index') }}"
                       class="btn btn-outline-secondary">
                        Back
                    </a>

                    <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                       class="btn btn-primary">
                        Edit
                    </a>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
