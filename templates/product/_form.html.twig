
{{ form_start(form) }}

    {{ form_errors(form) }}

    <div class="mb-3">
        {{ form_label(form.sku, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.sku, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.sku) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.basePrice, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.basePrice, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.basePrice) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.initialStock, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.initialStock, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.initialStock) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.status, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.status) }}
    </div>

    
    <div class="mb-3">
        {{ form_label(form.imageFile, 'Product image', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.imageFile, {
            'attr': {'class': 'form-control', 'accept': 'image/jpeg,image/png,image/webp'}
        }) }}

        {{ form_errors(form.imageFile) }}
    </div>


    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success">
            {{ button_label|default('Save product') }}
        </button>

        <a href="{{ path('app_product_index') }}"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

{{ form_end(form) }}
