
{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">
                Manage products in ChronosCart.
            </p>
        </div>

        <a href="{{ path('app_product_new') }}"
           class="btn btn-primary">
            + Add Product
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Base Price</th>
                        <th>Initial Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.id }}</td>
                            <td>
    {% if product.imageName %}
        <img
            src="{{ asset('uploads/products/' ~ product.imageName) }}"
            alt="{{ product.name }}"
            width="70"
            height="70"
            style="object-fit: cover;"
            class="rounded"
        >
    {% else %}
        <span class="text-muted">No image</span>
    {% endif %}
</td>
                            <td>{{ product.sku }}</td>
                            <td>{{ product.name }}</td>
                            <td>
                                {{ product.basePrice|number_format(2, '.', ',') }} €
                            </td>
                            <td>{{ product.initialStock }}</td>
                            <td>
                                {% set statusClass = {
                                    'DRAFT': 'secondary',
                                    'ACTIVE': 'success',
                                    'EXPIRED': 'danger'
                                } %}

                                <span class="badge bg-{{ statusClass[product.status] ?? 'secondary' }}">
                                    {{ product.status }}
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                                <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Change
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No products found.
                                <a href="{{ path('app_product_new') }}">
                                    Add your first product
                                </a>.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
