{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | ChronosCart{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f7f7f4;
            color: #202020;
            font-family: Arial, sans-serif;
        }

        .product-details-container {
            width: calc(100% - 40px);
            max-width: 1350px;
            margin: 35px auto;
            padding: 35px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.06);
        }

        .breadcrumb a {
            color: #777;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            color: #202020;
        }
        .product-image-wrapper {
            position: relative;
            width: 100%;
            height: 680px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #f5f6f8;
            border-radius: 20px;
        }

        .product-main-image {
            display: block;
            width: 100%;
            height: 640px;
            object-fit: contain;
            mix-blend-mode: multiply;
            transition: transform 0.3s ease;
        }

        .product-image-wrapper:hover .product-main-image {
            transform: scale(1.03);
        }

        .product-placeholder {
            text-align: center;
            color: #9ca3af;
        }

        .product-placeholder i {
            display: block;
            margin-bottom: 15px;
            font-size: 5rem;
        }

        /* Product information */
        .product-information {
            padding: 15px 10px 15px 20px;
        }

        .product-eyebrow {
            margin-bottom: 12px;
            color: #a16b76;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .product-title {
            margin-bottom: 15px;
            color: #202b40;
            font-family: Georgia, serif;
            font-size: clamp(1.8rem, 3vw, 2.7rem);
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .product-sku {
            color: #888;
            font-size: 13px;
        }

        .current-price {
            color: #202b40;
            font-size: 2rem;
            font-weight: 750;
        }

        .original-price {
            color: #999;
            font-size: 1.1rem;
            text-decoration: line-through;
        }

        .flash-sale-box {
            padding: 20px;
            background: #fff5f5;
            border: 1px solid #ffdada;
            border-radius: 14px;
        }

        .sale-badge {
            display: inline-block;
            margin-bottom: 12px;
            padding: 7px 10px;
            color: #fff;
            background: #d94d62;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 700;
        }

        .stock-information {
            padding: 15px;
            background: #f8f9f7;
            border-radius: 10px;
        }

        .quantity-input {
            width: 120px;
            height: 48px;
            border-radius: 9px;
        }

        .add-to-cart-btn {
            padding: 15px;
            color: #fff;
            background: #202b40;
            border: 1px solid #202b40;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .add-to-cart-btn:hover {
            color: #fff;
            background: #35435c;
            border-color: #35435c;
            transform: translateY(-1px);
        }

        .continue-shopping-btn {
            padding: 13px;
            border-radius: 10px;
        }

        @media (max-width: 991px) {
            .product-details-container {
                padding: 25px;
            }

            .product-image-wrapper {
                height: 500px;
            }

            .product-main-image {
                height: 460px;
            }

            .product-information {
                padding: 20px 0 0;
            }
        }

        @media (max-width: 767px) {
            .product-details-container {
                width: calc(100% - 24px);
                margin: 12px auto;
                padding: 18px;
            }

            .product-image-wrapper {
                height: 350px;
                padding: 15px;
            }

            .product-main-image {
                height: 320px;
            }

            .product-title {
                font-size: 1.8rem;
            }

            .current-price {
                font-size: 1.7rem;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="product-details-container">

    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_shop') }}">Shop</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
                {{ product.name }}
            </li>
        </ol>
    </nav>

    <div class="row g-4 align-items-start">

        {# Product image #}
        <div class="col-lg-7">
            <div class="product-image-wrapper">

                {% if product.status == 'ACTIVE' %}
                    <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2">
                        Active Product
                    </span>
                {% endif %}

                {% if product.imageName %}
                    <img
                        src="{{ asset('uploads/products/' ~ product.imageName) }}"
                        alt="{{ product.name }}"
                        class="product-main-image"
                    >
                {% else %}
                    <div class="product-placeholder">
                        <i class="bi bi-box-seam"></i>
                        <p class="mb-0">No product image available</p>
                    </div>
                {% endif %}

            </div>
        </div>

        {# Product information #}
        <div class="col-lg-5">
            <div class="product-information">

                <p class="product-eyebrow">
                    Product Details
                </p>

                <h1 class="product-title">
                    {{ product.name }}
                </h1>

                <p class="product-sku mb-4">
                    SKU: {{ product.sku }}
                </p>

                {# Flash Sale and pricing #}
                {% set flashEvent = flashSaleEvent|default(null) %}
                {% set now = date() %}

                {% set hasActiveSale =
                    flashEvent
                    and flashEvent.startTime <= now
                    and flashEvent.endTime >= now
                %}

                {% if hasActiveSale %}

                    {% set discount = flashEvent.discountPercentage %}
                    {% set finalPrice =
                        product.basePrice * (100 - discount) / 100
                    %}

                    <div class="flash-sale-box mb-4">

                        <span class="sale-badge">
                            <i class="bi bi-lightning-fill"></i>
                            FLASH SALE
                        </span>

                        <div class="d-flex align-items-center gap-3 flex-wrap">

                            <span class="current-price">
                                €{{ finalPrice|number_format(2, '.', ',') }}
                            </span>

                            <span class="original-price">
                                €{{ product.basePrice|number_format(2, '.', ',') }}
                            </span>

                            <span class="badge bg-success">
                                -{{ discount }}%
                            </span>

                        </div>

                        <p class="small text-secondary mt-3 mb-0">
                            <i class="bi bi-clock"></i>
                            Offer ends:
                            {{ flashEvent.endTime|date('d M Y, H:i') }}
                        </p>

                    </div>

                {% else %}

                    <div class="mb-4">
                        <span class="current-price">
                            €{{ product.basePrice|number_format(2, '.', ',') }}
                        </span>

                        {% if flashEvent and flashEvent.startTime > now %}
                            <p class="text-info mt-2 mb-0">
                                <i class="bi bi-clock"></i>
                                Flash Sale starts
                                {{ flashEvent.startTime|date('d M Y, H:i') }}
                            </p>
                        {% elseif flashEvent and flashEvent.endTime < now %}
                            <p class="text-secondary mt-2 mb-0">
                                Flash Sale has ended.
                            </p>
                        {% endif %}
                    </div>

                {% endif %}

                <hr class="my-4">

                {# Stock information #}
                <div class="stock-information mb-4">

                    {% if product.initialStock > 0 %}

                        <span class="text-success fw-semibold">
                            <i class="bi bi-check-circle-fill"></i>
                            In Stock
                        </span>

                        <p class="text-secondary small mt-2 mb-0">
                            {{ product.initialStock }} items available
                        </p>

                    {% else %}

                        <span class="text-danger fw-semibold">
                            <i class="bi bi-x-circle-fill"></i>
                            Out of Stock
                        </span>

                    {% endif %}

                </div>

                {# Add to Cart #}
                {% if product.initialStock > 0 %}

                    <form
                        action="{{ path('app_cart_add', {id: product.id}) }}"
                        method="post"
                    >

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('add_to_cart_' ~ product.id) }}"
                        >

                        <label for="quantity" class="form-label fw-semibold">
                            Quantity
                        </label>

                        <div class="mb-4">
                            <input
                                type="number"
                                id="quantity"
                                name="quantity"
                                class="form-control quantity-input"
                                value="1"
                                min="1"
                                max="{{ product.initialStock }}"
                                required
                            >
                        </div>

                        <button
                            type="submit"
                            class="btn add-to-cart-btn w-100"
                        >
                            <i class="bi bi-cart-plus me-2"></i>
                            Add to Cart
                        </button>

                    </form>

                {% else %}

                    <button
                        type="button"
                        class="btn btn-secondary w-100 py-3"
                        disabled
                    >
                        Out of Stock
                    </button>

                {% endif %}

                <a
                    href="{{ path('app_shop') }}"
                    class="btn btn-outline-secondary continue-shopping-btn w-100 mt-3"
                >
                    <i class="bi bi-arrow-left me-2"></i>
                    Continue Shopping
                </a>

            </div>
        </div>

    </div>
</div>

{% endblock %}
