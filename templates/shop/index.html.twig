
{% extends 'base.html.twig' %}

{% block title %}Our Products | ChronosCart{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #f7f7f4;
            color: #202020;
            font-family: Arial, sans-serif;
        }

       
.shop-container {
    width: calc(100% - 40px);
    max-width: 1250px;
    margin: 35px auto;
    padding: 40px;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.06);
}

.product-card {
    height: 100%;
    border: none;
    background: #fff;
    padding: 8px;
    transition: transform .2s ease;
}
.product-info {
    padding-left: 25px; 
}
.product-name {
    font-size: 17px;
    font-weight: 600;
    margin: 6px 0 10px;
}

.product-price {
    font-weight: 700;
    font-size: 16px;
}
        .eyebrow {
            color: #a16b76;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .shop-heading {
            font-family: Georgia, serif;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .product-card {
            height: 100%;
            border: none;
            background: #fff;
            transition: transform .2s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
        }

        

.product-image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: transparent;
    aspect-ratio: 1 / 1;
    width: 100%;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 0;
    mix-blend-mode: multiply;
    transition: transform .3s ease;
}


.product-card:hover .product-image {
    transform: scale(1.04);
}


        .image-placeholder {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #777;
            background: linear-gradient(135deg, #f4e9e9, #e7e7e7);
            font-size: 13px;
        }

        .sale-badge {
            position: absolute;
            top: 9px;
            left: 9px;
            background: #d94d62;
            color: #fff;
            padding: 5px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 7px;
            border-radius: 4px;
            margin-top: 5px;
        }

        .status-active {
            color: #176b45;
            background: #d9f3e5;
        }

        .status-upcoming {
            color: #8a6411;
            background: #fff0c2;
        }

        .status-expired {
            color: #a12e3c;
            background: #fde1e4;
        }

        .product-category {
            margin-top: 12px;
            color: #888;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            margin: 4px 0 8px;
        }

        .product-price {
            font-weight: 700;
            font-size: 15px;
        }

        .old-price {
            color: #999;
            font-size: 13px;
            text-decoration: line-through;
            margin-left: 5px;
        }

        .product-sku {
            color: #888;
            font-size: 12px;
        }

        .empty-products {
            padding: 50px 15px;
            text-align: center;
            background: #fafafa;
            border-radius: 12px;
        }

        @media (max-width: 576px) {
            .shop-container {
                margin: 12px;
                padding: 18px;
            }

            .product-name {
                font-size: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="shop-container">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <div class="eyebrow">Curated selection</div>
            <h1 class="shop-heading">Our Products</h1>
        </div>

        <span class="text-secondary small">
            {{ products|length }} products
        </span>
    </div>

    {% if products is empty %}
        <div class="empty-products">
            <h5>No products yet</h5>
            <p class="text-secondary mb-0">
                Add products through your admin panel to display them here.
            </p>
        </div>
    {% else %}
        
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">


            {% for product in products %}
                {% set event = eventsByProductId[product.id] ?? null %}
                {% set now = date() %}
                {% set eventStatus = null %}

                {% if event %}
                    {% if event.startTime > now %}
                        {% set eventStatus = 'Upcoming' %}
                    {% elseif event.endTime < now %}
                        {% set eventStatus = 'Expired' %}
                    {% else %}
                        {% set eventStatus = 'Active' %}
                    {% endif %}
                {% endif %}

                {% set hasActiveSale =
                    event and eventStatus == 'Active'
                %}

                {% set discountedPrice = product.basePrice %}

                {% if hasActiveSale %}
                    {% set discountedPrice =
                        product.basePrice *
                        (1 - event.discountPercentage / 100)
                    %}
                {% endif %}

                <div class="col">
                    <article class="product-card">

                        <div class="product-image-wrap">
                            {% if product.imageName %}
                                <img
                                    src="{{ asset('uploads/products/' ~ product.imageName) }}"
                                    alt="{{ product.name }}"
                                    class="product-image"
                                    loading="lazy"
                                >
                            {% else %}
                                <div class="image-placeholder">
                                    No image available
                                </div>
                            {% endif %}

                            {% if hasActiveSale %}
                                <span class="sale-badge">
                                    -{{ event.discountPercentage }}%
                                </span>
                            {% endif %}
                        </div>

                        <div class="product-info">

                        <div class="product-category">
                            {{ product.sku }}
                        </div>

                        <h2 class="product-name">
                            {{ product.name }}
                        </h2>

                        <div class="d-flex align-items-center flex-wrap">
                            <span class="product-price">
                                €{{ discountedPrice|number_format(2, '.', ',') }}
                            </span>

                            {% if hasActiveSale %}
                                <span class="old-price">
                                    €{{ product.basePrice|number_format(2, '.', ',') }}
                                </span>
                            {% endif %}
                        </div>

                        {% if event %}
                            {% if eventStatus == 'Active' %}
                                <span class="status-badge status-active">
                                    ACTIVE
                                </span>
                            {% elseif eventStatus == 'Upcoming' %}
                                <span class="status-badge status-upcoming">
                                    UPCOMING
                                </span>
                            {% else %}
                                <span class="status-badge status-expired">
                                    EXPIRED
                                </span>
                            {% endif %}
                        {% endif %}

                        <div class="product-sku mt-2">
                            Stock: {{ product.initialStock }}
                        </div>

                    </div>


                    
                    <div class="d-flex gap-2 mt-3">
                        <a
                        href="{{ path('app_shop_show', {id: product.id}) }}"
                        class="btn btn-outline-dark btn-sm flex-fill"
                    >
                        Product Details
                        </a>

                    {% if product.initialStock > 0 %}
                        <form
                            action="{{ path('app_cart_add', {id: product.id}) }}"
                            method="post"
                            class="flex-fill"
                        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('add_to_cart_' ~ product.id) }}"
            >
            <input type="hidden" name="quantity" value="1">

            <button type="submit" class="btn btn-dark btn-sm w-100">
                Add to Cart
            </button>
        </form>
    {% else %}
        <button class="btn btn-secondary btn-sm flex-fill" disabled>
            Out of Stock
        </button>
    {% endif %}
</div>

                    </article>
                </div>
            {% endfor %}

        </div>
    {% endif %}

</div>
{% endblock %}





