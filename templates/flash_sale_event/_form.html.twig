
{{ form_start(form) }}

    {{ form_errors(form) }}

    <div class="mb-3">
        {{ form_label(form.product, 'Product', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.product, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.product) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.startTime, 'Start date and time', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.startTime, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.startTime) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.endTime, 'End date and time', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.endTime, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.endTime) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.maxQuantityPerUser, 'Maximum quantity per user', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.maxQuantityPerUser, {'attr': {'class': 'form-control', 'min': 1}}) }}
        {{ form_errors(form.maxQuantityPerUser) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.discountPercentage, 'Discount percentage (%)', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.discountPercentage, {'attr': {'class': 'form-control', 'min': 0, 'max': 100, 'step': '0.01'}}) }}
        {{ form_errors(form.discountPercentage) }}
        <div class="form-text">Enter a value between 0 and 100.</div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success">
            {{ button_label|default('Save event') }}
        </button>

        <a href="{{ path('app_flash_sale_event_index') }}"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

{{ form_end(form) }}
