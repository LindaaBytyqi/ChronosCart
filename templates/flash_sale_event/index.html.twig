
{% extends 'base.html.twig' %}

{% block title %}Flash Sale Events{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Flash Sale Events</h1>
            <p class="text-muted mb-0">
                Manage promotional events in ChronosCart.
            </p>
        </div>

        <a href="{{ path('app_flash_sale_event_new') }}"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    {% set now = date() %}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Product</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Max/User</th>
                        <th>Discount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for flashSaleEvent in flashSaleEvents %}
                        {% if flashSaleEvent.startTime > now %}
                            {% set eventStatus = 'Upcoming' %}
                            {% set statusClass = 'info' %}
                        {% elseif flashSaleEvent.endTime < now %}
                            {% set eventStatus = 'Expired' %}
                            {% set statusClass = 'danger' %}
                        {% else %}
                            {% set eventStatus = 'Active' %}
                            {% set statusClass = 'success' %}
                        {% endif %}

                        <tr>
                            <td>{{ flashSaleEvent.id }}</td>
                            <td>
                                {{ flashSaleEvent.product.name }}
                            </td>
                            <td>
                                {{ flashSaleEvent.startTime|date('d.m.Y H:i') }}
                            </td>
                            <td>
                                {{ flashSaleEvent.endTime|date('d.m.Y H:i') }}
                            </td>
                            <td>{{ flashSaleEvent.maxQuantityPerUser }}</td>
                            <td>
                                {{ flashSaleEvent.discountPercentage }}%
                            </td>
                            <td>
                                <span class="badge bg-{{ statusClass }}">
                                    {{ eventStatus }}
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('app_flash_sale_event_show', {'id': flashSaleEvent.id}) }}"
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                                <a href="{{ path('app_flash_sale_event_edit', {'id': flashSaleEvent.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No flash sale events found.
                                <a href="{{ path('app_flash_sale_event_new') }}">
                                    Create your first event
                                </a>.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
