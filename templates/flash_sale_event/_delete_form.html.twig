
<form method="post"
      action="{{ path('app_flash_sale_event_delete', {'id': flashSaleEvent.id}) }}"
      class="d-inline"
      onsubmit="return confirm('Are you sure you want to delete this flash sale event?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ flashSaleEvent.id) }}">

    <button class="btn btn-outline-danger btn-sm">
        Delete
    </button>
</form>
