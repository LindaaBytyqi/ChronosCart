
{% extends 'base.html.twig' %}

{% block title %}View Flash Sale Event{% endblock %}

{% block body %}
    {% set now = date() %}

    {% if flashSaleEvent.startTime > now %}
        {% set eventStatus = 'Upcoming' %}
        {% set statusClass = 'info' %}
    {% elseif flashSaleEvent.endTime < now %}
        {% set eventStatus = 'Expired' %}
        {% set statusClass = 'danger' %}
    {% else %}
        {% set eventStatus = 'Active' %}
        {% set statusClass = 'success' %}
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h1 class="h5 mb-0">Flash Sale Event Details</h1>
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>ID:</strong> {{ flashSaleEvent.id }}
                    </li>
                    <li class="list-group-item">
                        <strong>Product:</strong> {{ flashSaleEvent.product.name }}
                    </li>
                    <li class="list-group-item">
                        <strong>Start:</strong>
                        {{ flashSaleEvent.startTime|date('d.m.Y H:i') }}
                    </li>
                    <li class="list-group-item">
                        <strong>End:</strong>
                        {{ flashSaleEvent.endTime|date('d.m.Y H:i') }}
                    </li>
                    <li class="list-group-item">
                        <strong>Maximum quantity per user:</strong>
                        {{ flashSaleEvent.maxQuantityPerUser }}
                    </li>
                    <li class="list-group-item">
                        <strong>Discount:</strong>
                        {{ flashSaleEvent.discountPercentage }}%
                    </li>
                    <li class="list-group-item">
                        <strong>Status:</strong>
                        <span class="badge bg-{{ statusClass }}">
                            {{ eventStatus }}
                        </span>
                    </li>
                </ul>

                <div class="card-body d-flex gap-2">
                    <a href="{{ path('app_flash_sale_event_index') }}"
                       class="btn btn-outline-secondary">
                        Back
                    </a>

                    <a href="{{ path('app_flash_sale_event_edit', {'id': flashSaleEvent.id}) }}"
                       class="btn btn-primary">
                        Edit
                    </a>

                </div>
            </div>
        </div>
    </div>
{% endblock %}
